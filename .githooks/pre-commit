#!/usr/bin/env bash
#
# PocketRadio pre-commit hook. Scoped to this repo and its nested repos only —
# never installed machine-globally.
#
#   Install / reinstall everywhere:  make hooks
#   Bypass once:                     git commit --no-verify
#
# Enforces the CLAUDE.md convention (see AGENTS.md):
#   CLAUDE.md is a plain file containing exactly "@AGENTS.md", with a sibling
#   AGENTS.md holding the real content. Never a symlink.
#
# Nested repos point core.hooksPath at this same file via a relative path, so
# there is one copy to maintain. Delegates to a repo's own .git/hooks/pre-commit
# if present, so setting core.hooksPath does not silently disable local hooks.

set -uo pipefail

status=0

# --- CLAUDE.md convention -------------------------------------------------

while IFS= read -r file; do
	[ -n "$file" ] || continue
	[ "$(basename "$file")" = "CLAUDE.md" ] || continue

	# Mode 120000 == symlink. Checked against the index, not the worktree.
	mode="$(git ls-files -s -- "$file" | awk '{print $1}')"
	if [ "$mode" = "120000" ]; then
		echo "pre-commit: $file is a symlink; it must be a plain file." >&2
		status=1
		continue
	fi

	# Compare the staged blob, not the worktree copy.
	content="$(git show ":$file" 2>/dev/null | tr -d '[:space:]')"
	if [ "$content" != "@AGENTS.md" ]; then
		echo "pre-commit: $file must contain exactly '@AGENTS.md' and nothing else." >&2
		echo "            Move its content into $(dirname "$file")/AGENTS.md." >&2
		status=1
		continue
	fi

	# A lone CLAUDE.md would be a dangling import.
	dir="$(dirname "$file")"
	agents="AGENTS.md"
	[ "$dir" != "." ] && agents="$dir/AGENTS.md"
	if ! git cat-file -e ":$agents" 2>/dev/null && [ ! -f "$agents" ]; then
		echo "pre-commit: $file imports @AGENTS.md but $agents does not exist." >&2
		status=1
	fi
	# Lowercase 'd' means "everything except deletions". Do NOT use ACM here:
	# that silently excludes T (typechange), which is exactly what a
	# symlink -> file CLAUDE.md migration looks like.
done < <(git diff --cached --name-only --diff-filter=d)

if [ "$status" -ne 0 ]; then
	echo "" >&2
	echo "Convention: AGENTS.md holds the content; CLAUDE.md is a one-line pointer." >&2
	echo "Bypass once with: git commit --no-verify" >&2
	exit "$status"
fi

# --- Delegate to the repo's own hook --------------------------------------
# Resolve via --git-dir, NOT `git rev-parse --git-path hooks/...`, which honors
# core.hooksPath and would resolve back to this file (infinite recursion).

local_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd -P)/$(basename "$local_hook")" != "$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")" ]; then
	exec "$local_hook" "$@"
fi

exit 0
